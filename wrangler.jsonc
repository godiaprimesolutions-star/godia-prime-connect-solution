{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godia-prime-connect-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "godia-prime-db",
      "database_id": "REPLACE_WITH_YOUR_NEW_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "GODIA PRIME CONNECT",
    "GOOGLE_CLIENT_ID": "SET_IN_CLOUDFLARE_DASHBOARD_OR_WRANGLER_SECRET"
  }
}
